# AWS Bedrock 자격 증명 (강의에서 안내받은 값을 넣는다. 이 예시 파일에는 실제 값을 적지 않는다)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 임시 자격 증명을 받았다면 세션 토큰도 넣는다. 없으면 비워 둔다
AWS_SESSION_TOKEN=
# 강의에서 안내받은 리전으로 바꾼다
AWS_REGION=us-east-1

# Bedrock 모델 ID. 강의 계정은 us. 추론 프로필 ID로만 호출된다 (허용: Sonnet 4.6, Sonnet 4.5, Haiku 4.5)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# RAGAS 채점 모델 (python evaluation/run_eval.py --ragas). 답변 모델과 다른 모델을 써서 자기 채점 편향을 줄인다
JUDGE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
